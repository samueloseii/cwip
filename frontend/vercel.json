{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://flow-nstl.onrender.com/api/:path*" },
    { "source": "/((?!assets|sw\\.js|workbox|manifest|registerSW|logo|icon).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(sw.js|registerSW.js|index.html|manifest.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
